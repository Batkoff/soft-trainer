# Prefer: python scripts/prepare_demo.py — generates unique secrets automatically.
# If configuring manually, fill all three values before starting Docker.
SECRET_KEY=
POSTGRES_PASSWORD=
DEMO_PASSWORD=
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_ADDRESS=:80
SECURE_COOKIES=0
DEMO_EVALUATION_DELAY=2
LOG_LEVEL=INFO
EVALUATOR_BACKEND=openrouter
EVALUATOR_MODEL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Почта для регистрации, подтверждения адреса и восстановления пароля.
# Заполняется только в локальном .env на сервере; секрет не коммитится.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=connect.smtp.bz
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=
